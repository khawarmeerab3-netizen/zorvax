# ============================================================
# ZORVAX — environment variables (TEMPLATE — copy to .env)
# Never commit real keys. This file documents every variable.
# ============================================================

# ---------- General ----------
NODE_ENV=development
PORT=3001

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- Supabase ----------
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key

# ---------- AI providers (free tiers) ----------
# Get keys from: console.groq.com / aistudio.google.com / console.mistral.ai / dashboard.cohere.com
# Model IDs are env-configurable so they can be updated as providers change.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest

COHERE_API_KEY=...
COHERE_MODEL=command-r

# ---------- AI caching / rate limiting ----------
# Optional. When unset, the API uses in-memory caches (single instance).
REDIS_URL=redis://localhost:6379
AI_CACHE_TTL_HOURS=24
AI_RATE_LIMIT_WINDOW_MINUTES=1

# ---------- Stripe (Phase 2 — subscriptions) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------- App URLs ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
